[flake8]
# Максимальная длина строки. 100 символов — это разумный компромисс для ML-кода.
# (По умолчанию flake8 ругается на строки длиннее 79 символов).
max-line-length = 100

# Исключаем служебные папки и файлы из проверки.
# Это ускорит работу линтера и уберет лишние ошибки из виртуального окружения.
exclude = 
    .git,
    __pycache__,
    .venv,
    venv,
    .ipynb_checkpoints,
    data,
    models

# Игнорируем правила, которые конфликтуют с Black.
# E203: пробел перед ':' (Black ставит его иначе)
# W503: перенос строки перед бинарным оператором (Black делает так)
# E501: длина строки (мы уже задали max-line-length, но на всякий случай игнорируем в строгих местах)
# E731: лямбда-выражения (часто используются в ML-коде)
extend-ignore = E203, W503, E731

# Некоторые дополнительные полезные настройки:
# Показывать номер строки и код ошибки при выводе (удобно для навигации)
show-source = True
statistics = True