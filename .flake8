[flake8]
max-line-length = 79

# Исключаем служебные папки и файлы из проверки
exclude = 
    .git,
    __pycache__,
    .venv,
    venv,
    .ipynb_checkpoints,
    data,
    models

# Игнорируем правила, которые конфликтуют с Black
# E203: пробел перед ':'
# W503: перенос строки перед бинарным оператором
# E731: лямбда-выражения
extend-ignore = E203, W503, E731

# Некоторые дополнительные полезные настройки
show-source = True
statistics = True